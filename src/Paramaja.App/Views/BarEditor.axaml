<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Paramaja.App.Views"
             xmlns:vm="using:Paramaja.App.ViewModels"
             x:Class="Paramaja.App.Views.BarEditor"
             x:DataType="vm:MainViewModel">
  <!-- Settings → Appearance: the controls bar as bands of chips, left, centre and right, then what's
       off the bar. Drag a chip to place it (code-behind), or click one and use the buttons below. -->
  <UserControl.Styles>
    <Style Selector="Border.bar-zone">
      <Setter Property="Background" Value="{DynamicResource ThemeBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ThemeRadiusControl}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="68" />
    </Style>
    <Style Selector="Border.bar-zone.drop">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
    </Style>
    <Style Selector="ContentControl.off Border.bar-zone">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.bar-chip">
      <Setter Property="Width" Value="78" />
      <Setter Property="Height" Value="54" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="4,6,4,4" />
      <Setter Property="Background" Value="{DynamicResource ThemeRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ThemeRadiusControl}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.bar-chip:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeTextMuted}" />
    </Style>
    <Style Selector="Border.bar-chip.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.bar-chip.dragged">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.bar-chip TextBlock.chip-label">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}" />
    </Style>
    <Style Selector="Border.bar-chip TextBlock.chip-sample">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.zone-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:BarZone">
      <Border Classes="bar-zone">
        <Grid ColumnDefinitions="64,*">
          <TextBlock Classes="zone-title" Text="{Binding Title}" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BarSlot">
                <Border Classes="bar-chip" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Tip}">
                  <Grid RowDefinitions="22,*">
                    <PathIcon Width="18" Height="18" IsVisible="{Binding HasIcon}"
                              Data="{Binding IconKey, Converter={x:Static v:BarEditor.IconOf}}" />
                    <TextBlock Classes="chip-sample" Text="{Binding Text}" IsVisible="{Binding !HasIcon}" />
                    <TextBlock Grid.Row="1" Classes="chip-label" Text="{Binding Label}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <StackPanel Spacing="6">
      <ItemsControl x:Name="Zones" ItemsSource="{Binding BarZones}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <ContentControl x:Name="OffZone" Content="{Binding BarOffZone}" Classes="off" Margin="0,4,0,0" />
      <TextBlock Classes="note" Text="Off the bar, a button is in More (⋯) where it fits there, and its shortcut works either way. Play, More and Settings always stay on the bar." />

      <WrapPanel Margin="0,4,0,0">
        <WrapPanel.Styles>
          <Style Selector="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
          </Style>
        </WrapPanel.Styles>
        <Button x:Name="EarlierButton" Classes="ghost" Content="◀ Earlier" Command="{Binding MoveSelectedEarlierCommand}" />
        <Button x:Name="LaterButton" Classes="ghost" Content="Later ▶" Command="{Binding MoveSelectedLaterCommand}" />
        <Button x:Name="ToLeftButton" Classes="ghost" Content="To left" Command="{Binding MoveSelectedToCommand}" CommandParameter="Left" />
        <Button x:Name="ToCentreButton" Classes="ghost" Content="To centre" Command="{Binding MoveSelectedToCommand}" CommandParameter="Centre" />
        <Button x:Name="ToRightButton" Classes="ghost" Content="To right" Command="{Binding MoveSelectedToCommand}" CommandParameter="Right" />
        <Button x:Name="TakeOffButton" Classes="ghost" Content="Take off the bar" Command="{Binding TakeSelectedOffCommand}" />
      </WrapPanel>
      <TextBlock x:Name="SelectionText" Classes="muted" FontSize="12" Text="{Binding SelectedBarSlotText}" />
    </StackPanel>

    <!-- While dragging: the chip under the pointer, and where it would go. -->
    <Canvas x:Name="DragLayer" IsHitTestVisible="False">
      <Border x:Name="Caret" Width="3" CornerRadius="1.5" Background="{DynamicResource ThemeAccent}" IsVisible="False" />
      <Border x:Name="Ghost" Classes="bar-chip" Opacity="0.85" IsVisible="False">
        <TextBlock x:Name="GhostLabel" Classes="chip-label" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Border>
    </Canvas>
  </Panel>
</UserControl>
