<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Paramaja</AssemblyName>
    <RootNamespace>Paramaja.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\paramaja.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.0.0-beta.9</Version>
    <Product>Paramaja</Product>
    <Description>Modern portable video player with HDR tonemapping and magnet streaming</Description>
    <Company>Raul Blideran</Company>
    <Copyright>© 2026 Raul Blideran · GPL-3.0-or-later</Copyright>
    <!-- The commit is appended by build/publish-win.sh (SourceRevisionId), e.g. 1.1.0+50919f7. -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- The .NET runtime a self-contained publish (the Windows zip, the Flatpak) bundles. Without
       it each bundles the runtime its SDK shipped with, and Flathub's dotnet10 extension lags:
       on 2026-11-24 it still carried 10.0.8, six patches and 100 CVE fixes behind. Keep it at
       the newest 10.0 patch (https://dotnet.microsoft.com/download/dotnet/10.0); the runtime
       pack is fetched from NuGet whatever SDK builds. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <InternalsVisibleTo Include="Paramaja.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Native libraries (libmpv + paramaja_torrent) are staged in libs/<rid> by build/fetch-libs.sh. -->
  <PropertyGroup>
    <ParamajaNativeRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ParamajaNativeRid>
    <ParamajaNativeRid Condition="'$(ParamajaNativeRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</ParamajaNativeRid>
    <ParamajaNativeRid Condition="'$(ParamajaNativeRid)' == ''">linux-x64</ParamajaNativeRid>
    <!-- A single-file bundle that would leave files out fails the build instead of warning. -->
    <WarningsAsErrors>$(WarningsAsErrors);NETSDK1236</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Published beside Paramaja.exe, never offered to the single-file bundle. The .NET 11 SDK
         drops native files the bundle refuses (NETSDK1236) where older SDKs copied them beside
         it, so the beta.2 and beta.3 zips shipped without libmpv, libVLC or FFmpeg. -->
    <None Include="..\..\libs\$(ParamajaNativeRid)\**\*" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"
          Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paramaja.Core\Paramaja.Core.csproj" />
  </ItemGroup>

</Project>
