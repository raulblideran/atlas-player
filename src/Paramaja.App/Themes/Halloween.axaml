<!--
  The "Halloween" theme. Pumpkin orange, slime green and a midnight-purple night.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#0B0710" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#130C18" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#1C1222" />
  <SolidColorBrush x:Key="ThemeHover" Color="#27182F" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#3D2448" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#2F1C38" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F2130C18" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#F6ECDD" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#BBA8B2" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#FF7A1A" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#FF8F3D" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#160A02" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#9DFF3A" />
  <SolidColorBrush x:Key="ThemePositive" Color="#9DFF3A" />
  <!-- The bars over the video: they fade into the picture, with no line -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F8F0E3" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#F208050C" />
    <GradientStop Offset="0.6" Color="#B308050C" />
    <GradientStop Offset="1" Color="#0008050C" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#0008050C" />
    <GradientStop Offset="0.35" Color="#B308050C" />
    <GradientStop Offset="1" Color="#F208050C" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarEdge" Color="#00000000" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#55FF7A1A" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#FF7A1A" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#FF8F3D" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#160A02" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#80FF7A1A" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F8F0E3" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#FF7A1A" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#9DFF3A" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F2130C18" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F8F0E3" />
  <!-- The welcome screen and titles -->
  <RadialGradientBrush Center="50%,30%" GradientOrigin="50%,30%" RadiusX="70%" RadiusY="70%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#3A1A08" />
    <GradientStop Offset="1" Color="#0B0710" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#FF7A1A" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">10</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">14</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is Inter in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">avares://Paramaja/Assets/Fonts#Creepster</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">48</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">28</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">23</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#FF7A1A</Color>
  <Color x:Key="ThemePaletteRegionColor">#130C18</Color>
  <Color x:Key="ThemePaletteAltHigh">#0B0710</Color>
  <Color x:Key="ThemePaletteChromeLow">#130C18</Color>
  <Color x:Key="ThemePaletteChromeMedium">#1C1222</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#1C1222</Color>
  <Color x:Key="ThemePaletteBaseHigh">#F6ECDD</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#160A02" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#160A02" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#160A02" />
</ResourceDictionary>
