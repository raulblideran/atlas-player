<!--
  The "Paramaja" theme. The default: Paramaja's plum and orchid, with the leaf green for progress.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#0D0A11" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#16111B" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#201927" />
  <SolidColorBrush x:Key="ThemeHover" Color="#2B2234" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#3A2E45" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#2E2338" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F2181320" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#F1EAF5" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#ABA0B5" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#9A4FAE" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#AC62C0" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#D29CE3" />
  <SolidColorBrush x:Key="ThemePositive" Color="#8BD05C" />
  <!-- The bars over the video: solid grounds (a line in ThemeStroke parts them from the picture) -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F4EEF7" />
  <SolidColorBrush x:Key="ThemeBarScrimTop" Color="#0B0910" />
  <SolidColorBrush x:Key="ThemeBarScrimBottom" Color="#0B0910" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#559A4FAE" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#9A4FAE" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#AC62C0" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#669A4FAE" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F2EAF6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#C98BDB" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F2181320" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F4EEF7" />
  <!-- The welcome screen and titles -->
  <RadialGradientBrush Center="50%,38%" GradientOrigin="50%,38%" RadiusX="75%" RadiusY="75%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#2A1532" />
    <GradientStop Offset="1" Color="#0B0910" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#F1EAF5" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">8</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is Inter in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">fonts:Inter#Inter</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Bold</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">34</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#9A4FAE</Color>
  <Color x:Key="ThemePaletteRegionColor">#16111B</Color>
  <Color x:Key="ThemePaletteAltHigh">#0D0A11</Color>
  <Color x:Key="ThemePaletteChromeLow">#16111B</Color>
  <Color x:Key="ThemePaletteChromeMedium">#201927</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#201927</Color>
  <Color x:Key="ThemePaletteBaseHigh">#F1EAF5</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
</ResourceDictionary>
