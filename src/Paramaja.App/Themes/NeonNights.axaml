<!--
  The "Neon Nights" theme. Criminal night and indigo lit by cyan, electric purple and lip-gloss pink.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#10182D" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#141D36" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#25245C" />
  <SolidColorBrush x:Key="ThemeHover" Color="#2F2D70" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#403C8A" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#3A2A78" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F2141D36" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#F4F2FF" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#B6B4D8" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#8B4DFF" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#9D66FF" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#FF4FA3" />
  <SolidColorBrush x:Key="ThemePositive" Color="#26C6DA" />
  <!-- The bars over the video: they fade into the picture, with no line -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F2F4F6" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#F20B1122" />
    <GradientStop Offset="0.6" Color="#B30B1122" />
    <GradientStop Offset="1" Color="#000B1122" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#000B1122" />
    <GradientStop Offset="0.35" Color="#B30B1122" />
    <GradientStop Offset="1" Color="#F20B1122" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarEdge" Color="#00000000" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#558B4DFF" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#8B4DFF" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#9D66FF" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#808B4DFF" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F2F4F6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeSeekProgress">
    <GradientStop Offset="0" Color="#26C6DA" />
    <GradientStop Offset="0.5" Color="#8B4DFF" />
    <GradientStop Offset="1" Color="#FF4FA3" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F2141D36" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F2F4F6" />
  <!-- The welcome screen and titles -->
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#10182D" />
    <GradientStop Offset="0.6" Color="#25245C" />
    <GradientStop Offset="0.88" Color="#4A2A8A" />
    <GradientStop Offset="1" Color="#7A2E7E" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeTitle">
    <GradientStop Offset="0" Color="#26C6DA" />
    <GradientStop Offset="0.5" Color="#8B4DFF" />
    <GradientStop Offset="1" Color="#FF4FA3" />
  </LinearGradientBrush>
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">12</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">14</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">18</CornerRadius>
  <!-- Titles' type (body text is the interface font in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">avares://Paramaja/Assets/Fonts#Audiowide</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">46</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">28</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">22</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#8B4DFF</Color>
  <Color x:Key="ThemePaletteRegionColor">#141D36</Color>
  <Color x:Key="ThemePaletteAltHigh">#10182D</Color>
  <Color x:Key="ThemePaletteChromeLow">#141D36</Color>
  <Color x:Key="ThemePaletteChromeMedium">#25245C</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#25245C</Color>
  <Color x:Key="ThemePaletteBaseHigh">#F4F2FF</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
</ResourceDictionary>
