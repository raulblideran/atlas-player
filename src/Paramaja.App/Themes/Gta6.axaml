<!--
  The "GTA 6" theme. Vice Beach after dark: sunset pink and orange, neon teal, poster type.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#120A1A" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#190F23" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#23152F" />
  <SolidColorBrush x:Key="ThemeHover" Color="#2E1B3D" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#45284F" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#3A1D45" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F21A0F24" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#FFF0F5" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#C9AAC2" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#FF4F8B" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#FF6A9C" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#1A0A14" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#FFB347" />
  <SolidColorBrush x:Key="ThemePositive" Color="#3EE0C8" />
  <!-- The bars over the video -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#FFF4F8" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#F20E0714" />
    <GradientStop Offset="0.6" Color="#B30E0714" />
    <GradientStop Offset="1" Color="#000E0714" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#000E0714" />
    <GradientStop Offset="0.35" Color="#B30E0714" />
    <GradientStop Offset="1" Color="#F20E0714" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#55FF4F8B" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#80FF4F8B" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#FFF4F8" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeSeekProgress">
    <GradientStop Offset="0" Color="#FF4F8B" />
    <GradientStop Offset="1" Color="#FFB347" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F21A0F24" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#FFF4F8" />
  <!-- The welcome screen and titles -->
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#120A1A" />
    <GradientStop Offset="0.55" Color="#2E0F38" />
    <GradientStop Offset="0.85" Color="#5E1E48" />
    <GradientStop Offset="1" Color="#8A3448" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeTitle">
    <GradientStop Offset="0" Color="#FF4F8B" />
    <GradientStop Offset="0.55" Color="#FF9F45" />
    <GradientStop Offset="1" Color="#FFD36B" />
  </LinearGradientBrush>
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">10</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">18</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">18</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is Inter in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">avares://Paramaja/Assets/Fonts#Anton</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">46</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">28</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">22</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#FF4F8B</Color>
  <Color x:Key="ThemePaletteRegionColor">#190F23</Color>
  <Color x:Key="ThemePaletteAltHigh">#120A1A</Color>
  <Color x:Key="ThemePaletteChromeLow">#190F23</Color>
  <Color x:Key="ThemePaletteChromeMedium">#23152F</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#23152F</Color>
  <Color x:Key="ThemePaletteBaseHigh">#FFF0F5</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1A0A14" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1A0A14" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#1A0A14" />
</ResourceDictionary>
