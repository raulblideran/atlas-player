<!--
  The "Deep Sea" theme. Ink-blue depths with a teal light.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#06101A" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#0B1825" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#112233" />
  <SolidColorBrush x:Key="ThemeHover" Color="#182D42" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#21394F" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#15293B" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F20B1825" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#E3F0F6" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#93AEBE" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#0A7A7C" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#0D8B8D" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#62D8D2" />
  <SolidColorBrush x:Key="ThemePositive" Color="#6FD39A" />
  <!-- The bars over the video: solid grounds (a line in ThemeStroke parts them from the picture) -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#EAF5F9" />
  <SolidColorBrush x:Key="ThemeBarScrimTop" Color="#050D15" />
  <SolidColorBrush x:Key="ThemeBarScrimBottom" Color="#050D15" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#550A7A7C" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#0A7A7C" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#0D8B8D" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#660A7A7C" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#E8F4F8" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#3CC4C0" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F20B1825" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#EAF5F9" />
  <!-- The welcome screen and titles -->
  <RadialGradientBrush Center="50%,38%" GradientOrigin="50%,38%" RadiusX="75%" RadiusY="75%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#0F3040" />
    <GradientStop Offset="1" Color="#050D15" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#E3F0F6" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">5</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">10</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">14</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is Inter in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">fonts:Inter#Inter</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Bold</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">34</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#0A7A7C</Color>
  <Color x:Key="ThemePaletteRegionColor">#0B1825</Color>
  <Color x:Key="ThemePaletteAltHigh">#06101A</Color>
  <Color x:Key="ThemePaletteChromeLow">#0B1825</Color>
  <Color x:Key="ThemePaletteChromeMedium">#112233</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#112233</Color>
  <Color x:Key="ThemePaletteBaseHigh">#E3F0F6</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
</ResourceDictionary>
