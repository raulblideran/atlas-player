<!--
  The "Paramaja Light" theme. Paramaja's colours on light grounds, for bright rooms.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#F4F0F6" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#FBF9FC" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHover" Color="#EFE8F3" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#DCD1E3" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#E9DEF0" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#FAFFFFFF" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#1F1726" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#5D5167" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#843C9A" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#9549AB" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#7A2C90" />
  <SolidColorBrush x:Key="ThemePositive" Color="#3B7A18" />
  <!-- The bars over the video: solid grounds, a line in ThemeBarEdge parting them from the picture -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#1F1726" />
  <SolidColorBrush x:Key="ThemeBarScrimTop" Color="#F4F0F6" />
  <SolidColorBrush x:Key="ThemeBarScrimBottom" Color="#F4F0F6" />
  <SolidColorBrush x:Key="ThemeBarEdge" Color="#DCD1E3" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#1F1F1726" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#55843C9A" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#843C9A" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#9549AB" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#1F1F1726" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#40843C9A" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#1F1726" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#331F1726" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#591F1726" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#843C9A" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#843C9A" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#FAFFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#1F1726" />
  <!-- The welcome screen and titles -->
  <RadialGradientBrush Center="50%,38%" GradientOrigin="50%,38%" RadiusX="75%" RadiusY="75%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#EBDDF2" />
    <GradientStop Offset="1" Color="#F4F0F6" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#1F1726" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">8</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is Inter in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">fonts:Inter#Inter</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Bold</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">34</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#843C9A</Color>
  <Color x:Key="ThemePaletteRegionColor">#FBF9FC</Color>
  <Color x:Key="ThemePaletteAltHigh">#F4F0F6</Color>
  <Color x:Key="ThemePaletteChromeLow">#FBF9FC</Color>
  <Color x:Key="ThemePaletteChromeMedium">#FFFFFF</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#FFFFFF</Color>
  <Color x:Key="ThemePaletteBaseHigh">#1F1726</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
</ResourceDictionary>
