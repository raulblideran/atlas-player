<!--
  The "Red Dead Redemption 2" theme. Saddle leather, bone and dried blood: old western print.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#0F0B08" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#17110D" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#211912" />
  <SolidColorBrush x:Key="ThemeHover" Color="#2C2118" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#4A3721" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#33241A" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F217110D" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#EFE3CC" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#B5A486" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#C0302A" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#D03A33" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#F7EEDC" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#D9B26A" />
  <SolidColorBrush x:Key="ThemePositive" Color="#A9BD72" />
  <!-- The bars over the video: solid grounds (a line in ThemeStroke parts them from the picture) -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F3E8D3" />
  <SolidColorBrush x:Key="ThemeBarScrimTop" Color="#0A0705" />
  <SolidColorBrush x:Key="ThemeBarScrimBottom" Color="#0A0705" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#55C0302A" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#C0302A" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#D03A33" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#F7EEDC" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#26EFE3CC" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#80C0302A" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F3E8D3" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40EFE3CC" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70EFE3CC" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#C2302A" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#EFE3CC" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F217110D" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F3E8D3" />
  <!-- The welcome screen and titles -->
  <RadialGradientBrush Center="50%,38%" GradientOrigin="50%,38%" RadiusX="80%" RadiusY="80%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#3A2614" />
    <GradientStop Offset="1" Color="#0A0705" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#EFE3CC" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">2</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">2</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">3</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">3</CornerRadius>
  <!-- Titles' type (body text is Inter in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">avares://Paramaja/Assets/Fonts#Rye</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">36</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">22</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">19</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#C0302A</Color>
  <Color x:Key="ThemePaletteRegionColor">#17110D</Color>
  <Color x:Key="ThemePaletteAltHigh">#0F0B08</Color>
  <Color x:Key="ThemePaletteChromeLow">#17110D</Color>
  <Color x:Key="ThemePaletteChromeMedium">#211912</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#211912</Color>
  <Color x:Key="ThemePaletteBaseHigh">#EFE3CC</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#F7EEDC" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#F7EEDC" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#F7EEDC" />
</ResourceDictionary>
