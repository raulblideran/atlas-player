<!--
  The "Vice City Sunset" theme. Electric blue through neon violet and vice pink to golden hour.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#0E0C26" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#151236" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#1F1B4A" />
  <SolidColorBrush x:Key="ThemeHover" Color="#2A2560" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#3D3680" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#33246A" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F2151236" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#FFF2FA" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#C4B7DE" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#EB45A4" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#F062B4" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#1A0614" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#FFAC42" />
  <SolidColorBrush x:Key="ThemePositive" Color="#FA8057" />
  <!-- The bars over the video -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F2F4F6" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#F20A0820" />
    <GradientStop Offset="0.6" Color="#B30A0820" />
    <GradientStop Offset="1" Color="#000A0820" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#000A0820" />
    <GradientStop Offset="0.35" Color="#B30A0820" />
    <GradientStop Offset="1" Color="#F20A0820" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#55EB45A4" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#80EB45A4" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F2F4F6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeSeekProgress">
    <GradientStop Offset="0" Color="#4442C0" />
    <GradientStop Offset="0.25" Color="#BF35C1" />
    <GradientStop Offset="0.5" Color="#EB45A4" />
    <GradientStop Offset="0.75" Color="#FA8057" />
    <GradientStop Offset="1" Color="#FFAC42" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F2151236" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F2F4F6" />
  <!-- The welcome screen and titles -->
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#0E0C26" />
    <GradientStop Offset="0.45" Color="#2A2470" />
    <GradientStop Offset="0.75" Color="#6A2380" />
    <GradientStop Offset="0.92" Color="#A8366E" />
    <GradientStop Offset="1" Color="#C8603F" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeTitle">
    <GradientStop Offset="0" Color="#6866E0" />
    <GradientStop Offset="0.25" Color="#BF35C1" />
    <GradientStop Offset="0.5" Color="#EB45A4" />
    <GradientStop Offset="0.75" Color="#FA8057" />
    <GradientStop Offset="1" Color="#FFAC42" />
  </LinearGradientBrush>
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">10</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">18</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">18</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is the interface font in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">avares://Paramaja/Assets/Fonts#Anton</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">46</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">28</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">22</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#EB45A4</Color>
  <Color x:Key="ThemePaletteRegionColor">#151236</Color>
  <Color x:Key="ThemePaletteAltHigh">#0E0C26</Color>
  <Color x:Key="ThemePaletteChromeLow">#151236</Color>
  <Color x:Key="ThemePaletteChromeMedium">#1F1B4A</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#1F1B4A</Color>
  <Color x:Key="ThemePaletteBaseHigh">#FFF2FA</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1A0614" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1A0614" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#1A0614" />
</ResourceDictionary>
