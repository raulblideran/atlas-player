<!--
  The "Apple Music" theme. Near-black glass and Apple Music's pink-red, soft round corners.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#121214" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#1C1C1E" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#2C2C2E" />
  <SolidColorBrush x:Key="ThemeHover" Color="#3A3A3C" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#3A3A3C" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#3A2228" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F21C1C1E" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#F5F5F7" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#A1A1A6" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#E0223C" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#EE354E" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#FF8A9B" />
  <SolidColorBrush x:Key="ThemePositive" Color="#30D158" />
  <!-- The bars over the video: solid grounds (a line in ThemeStroke parts them from the picture) -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F2F4F6" />
  <SolidColorBrush x:Key="ThemeBarScrimTop" Color="#0C0C0E" />
  <SolidColorBrush x:Key="ThemeBarScrimBottom" Color="#0C0C0E" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#55E0223C" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#E0223C" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#EE354E" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#66E0223C" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F2F4F6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeSeekProgress">
    <GradientStop Offset="0" Color="#FA2D48" />
    <GradientStop Offset="1" Color="#FB5C74" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F21C1C1E" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F2F4F6" />
  <!-- The welcome screen and titles -->
  <RadialGradientBrush Center="50%,38%" GradientOrigin="50%,38%" RadiusX="75%" RadiusY="75%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#3A0E17" />
    <GradientStop Offset="1" Color="#121214" />
  </RadialGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeTitle">
    <GradientStop Offset="0" Color="#FA2D48" />
    <GradientStop Offset="1" Color="#FB5C74" />
  </LinearGradientBrush>
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">10</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">14</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">18</CornerRadius>
  <!-- Titles' type (body text is the interface font in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">fonts:Inter#Inter</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Bold</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">34</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#E0223C</Color>
  <Color x:Key="ThemePaletteRegionColor">#1C1C1E</Color>
  <Color x:Key="ThemePaletteAltHigh">#121214</Color>
  <Color x:Key="ThemePaletteChromeLow">#1C1C1E</Color>
  <Color x:Key="ThemePaletteChromeMedium">#2C2C2E</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#2C2C2E</Color>
  <Color x:Key="ThemePaletteBaseHigh">#F5F5F7</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
</ResourceDictionary>
