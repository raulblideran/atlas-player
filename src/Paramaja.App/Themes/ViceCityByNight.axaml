<!--
  The "Vice City by Night" theme. Deep night and nightfall blue under hot pink and lilac haze.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#171B36" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#1C2142" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#303D72" />
  <SolidColorBrush x:Key="ThemeHover" Color="#3A4884" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#4A5896" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#4A3778" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F21C2142" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#FFF0F6" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#BFC2E0" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#F1588D" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#F4739F" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#1C0611" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#FF8FB6" />
  <SolidColorBrush x:Key="ThemePositive" Color="#D38BE6" />
  <!-- The bars over the video: a light fade into the picture (75% at the edge), no line -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F2F4F6" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#BF121530" />
    <GradientStop Offset="0.5" Color="#66121530" />
    <GradientStop Offset="1" Color="#00121530" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#00121530" />
    <GradientStop Offset="0.4" Color="#66121530" />
    <GradientStop Offset="1" Color="#BF121530" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarEdge" Color="#00000000" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#55F1588D" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#F1588D" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#F4739F" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#1C0611" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#80F1588D" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F2F4F6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeSeekProgress">
    <GradientStop Offset="0" Color="#F1588D" />
    <GradientStop Offset="0.5" Color="#B65ACD" />
    <GradientStop Offset="1" Color="#7046A3" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F21C2142" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F2F4F6" />
  <!-- The welcome screen and titles -->
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#171B36" />
    <GradientStop Offset="0.55" Color="#303D72" />
    <GradientStop Offset="0.85" Color="#7046A3" />
    <GradientStop Offset="1" Color="#B65ACD" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeTitle">
    <GradientStop Offset="0" Color="#F1588D" />
    <GradientStop Offset="0.5" Color="#B65ACD" />
    <GradientStop Offset="1" Color="#8A63D2" />
  </LinearGradientBrush>
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">10</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">18</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">18</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is the interface font in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">avares://Paramaja/Assets/Fonts#Anton</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">46</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">28</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">22</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#F1588D</Color>
  <Color x:Key="ThemePaletteRegionColor">#1C2142</Color>
  <Color x:Key="ThemePaletteAltHigh">#171B36</Color>
  <Color x:Key="ThemePaletteChromeLow">#1C2142</Color>
  <Color x:Key="ThemePaletteChromeMedium">#303D72</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#303D72</Color>
  <Color x:Key="ThemePaletteBaseHigh">#FFF0F6</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1C0611" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1C0611" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#1C0611" />
</ResourceDictionary>
