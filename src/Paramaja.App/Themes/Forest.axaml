<!--
  The "Forest" theme. Deep green shade with moss-light accents.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#0A100C" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#101813" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#17221B" />
  <SolidColorBrush x:Key="ThemeHover" Color="#1F2E24" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#2A3C30" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#1C2B21" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F2101813" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#E7F0E8" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#9DB0A1" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#6DBE7C" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#80CC8D" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#07120A" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#B2E39A" />
  <SolidColorBrush x:Key="ThemePositive" Color="#B2E39A" />
  <!-- The bars over the video: solid grounds (a line in ThemeStroke parts them from the picture) -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#EEF5EF" />
  <SolidColorBrush x:Key="ThemeBarScrimTop" Color="#080D0A" />
  <SolidColorBrush x:Key="ThemeBarScrimBottom" Color="#080D0A" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#556DBE7C" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#6DBE7C" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#80CC8D" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#07120A" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#666DBE7C" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#EEF5EF" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#6DBE7C" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F2101813" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#EEF5EF" />
  <!-- The welcome screen and titles -->
  <RadialGradientBrush Center="50%,38%" GradientOrigin="50%,38%" RadiusX="75%" RadiusY="75%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#14301C" />
    <GradientStop Offset="1" Color="#080D0A" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#E7F0E8" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">8</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is Inter in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">fonts:Inter#Inter</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Bold</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">34</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#6DBE7C</Color>
  <Color x:Key="ThemePaletteRegionColor">#101813</Color>
  <Color x:Key="ThemePaletteAltHigh">#0A100C</Color>
  <Color x:Key="ThemePaletteChromeLow">#101813</Color>
  <Color x:Key="ThemePaletteChromeMedium">#17221B</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#17221B</Color>
  <Color x:Key="ThemePaletteBaseHigh">#E7F0E8</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#07120A" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#07120A" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#07120A" />
</ResourceDictionary>
