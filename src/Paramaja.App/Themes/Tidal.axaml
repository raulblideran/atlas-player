<!--
  The "Tidal" theme. Tidal's pure black and white with a cyan light, sharp edges.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#000000" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#0D0D0F" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#17171A" />
  <SolidColorBrush x:Key="ThemeHover" Color="#222226" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#2E2E33" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#0F2A2C" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F20D0D0F" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#A6A6AD" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#3FE0E8" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#6BE9EF" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#000000" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#8FF3F7" />
  <SolidColorBrush x:Key="ThemePositive" Color="#3FE0E8" />
  <!-- The bars over the video: solid grounds (a line in ThemeStroke parts them from the picture) -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F2F4F6" />
  <SolidColorBrush x:Key="ThemeBarScrimTop" Color="#000000" />
  <SolidColorBrush x:Key="ThemeBarScrimBottom" Color="#000000" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#553FE0E8" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#3FE0E8" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#6BE9EF" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#000000" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#663FE0E8" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F2F4F6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#3FE0E8" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F20D0D0F" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F2F4F6" />
  <!-- The welcome screen and titles -->
  <RadialGradientBrush Center="50%,38%" GradientOrigin="50%,38%" RadiusX="75%" RadiusY="75%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#0A2A2C" />
    <GradientStop Offset="1" Color="#000000" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#FFFFFF" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">2</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">4</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">6</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">4</CornerRadius>
  <!-- Titles' type (body text is the interface font in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">fonts:Inter#Inter</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Bold</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">34</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#3FE0E8</Color>
  <Color x:Key="ThemePaletteRegionColor">#0D0D0F</Color>
  <Color x:Key="ThemePaletteAltHigh">#000000</Color>
  <Color x:Key="ThemePaletteChromeLow">#0D0D0F</Color>
  <Color x:Key="ThemePaletteChromeMedium">#17171A</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#17171A</Color>
  <Color x:Key="ThemePaletteBaseHigh">#FFFFFF</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#000000" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#000000" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#000000" />
</ResourceDictionary>
