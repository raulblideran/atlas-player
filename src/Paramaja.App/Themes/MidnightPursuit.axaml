<!--
  The "Midnight Pursuit" theme. Street blue at night, police blue and siren red lights.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#071530" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#0A1F44" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#122C5C" />
  <SolidColorBrush x:Key="ThemeHover" Color="#183870" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#244A8C" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#1A3A7A" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F20A1F44" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#E6F3FF" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#A9BEDC" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#0066FF" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#2A7FFF" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#FF5C7A" />
  <SolidColorBrush x:Key="ThemePositive" Color="#E6F3FF" />
  <!-- The bars over the video -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F2F4F6" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#F205102A" />
    <GradientStop Offset="0.6" Color="#B305102A" />
    <GradientStop Offset="1" Color="#0005102A" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#0005102A" />
    <GradientStop Offset="0.35" Color="#B305102A" />
    <GradientStop Offset="1" Color="#F205102A" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#550066FF" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#800066FF" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F2F4F6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeSeekProgress">
    <GradientStop Offset="0" Color="#0066FF" />
    <GradientStop Offset="0.5" Color="#8A00FF" />
    <GradientStop Offset="1" Color="#FF1744" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F20A1F44" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F2F4F6" />
  <!-- The welcome screen and titles -->
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#071530" />
    <GradientStop Offset="0.55" Color="#0A1F44" />
    <GradientStop Offset="0.85" Color="#2A1470" />
    <GradientStop Offset="1" Color="#5A0E3A" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeTitle">
    <GradientStop Offset="0" Color="#3D8BFF" />
    <GradientStop Offset="0.5" Color="#A040FF" />
    <GradientStop Offset="1" Color="#FF1744" />
  </LinearGradientBrush>
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">8</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">10</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">12</CornerRadius>
  <!-- Titles' type (body text is the interface font in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">avares://Paramaja/Assets/Fonts#Audiowide</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">46</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">28</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">22</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#0066FF</Color>
  <Color x:Key="ThemePaletteRegionColor">#0A1F44</Color>
  <Color x:Key="ThemePaletteAltHigh">#071530</Color>
  <Color x:Key="ThemePaletteChromeLow">#0A1F44</Color>
  <Color x:Key="ThemePaletteChromeMedium">#122C5C</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#122C5C</Color>
  <Color x:Key="ThemePaletteBaseHigh">#E6F3FF</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
</ResourceDictionary>
