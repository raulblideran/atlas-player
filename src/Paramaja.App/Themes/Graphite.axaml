<!--
  The "Graphite" theme. Neutral greys with a clear blue: nothing between you and the picture.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#0E1012" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#16181B" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#1E2125" />
  <SolidColorBrush x:Key="ThemeHover" Color="#282C31" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#353A40" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#252A31" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F2181A1D" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#ECEFF2" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#A0A7AF" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#2F6BEB" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#3F7AF5" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#86B4FF" />
  <SolidColorBrush x:Key="ThemePositive" Color="#5CC98A" />
  <!-- The bars over the video -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F2F4F6" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#F20B0C0E" />
    <GradientStop Offset="0.6" Color="#B30B0C0E" />
    <GradientStop Offset="1" Color="#000B0C0E" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#000B0C0E" />
    <GradientStop Offset="0.35" Color="#B30B0C0E" />
    <GradientStop Offset="1" Color="#F20B0C0E" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#552F6BEB" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#662F6BEB" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#EEF1F4" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#5B8FFF" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F2181A1D" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F2F4F6" />
  <!-- The welcome screen and titles -->
  <RadialGradientBrush Center="50%,38%" GradientOrigin="50%,38%" RadiusX="75%" RadiusY="75%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#1C232D" />
    <GradientStop Offset="1" Color="#0B0C0E" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#ECEFF2" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">6</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">10</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">6</CornerRadius>
  <!-- Titles' type (body text is Inter in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">fonts:Inter#Inter</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">SemiBold</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">34</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#2F6BEB</Color>
  <Color x:Key="ThemePaletteRegionColor">#16181B</Color>
  <Color x:Key="ThemePaletteAltHigh">#0E1012</Color>
  <Color x:Key="ThemePaletteChromeLow">#16181B</Color>
  <Color x:Key="ThemePaletteChromeMedium">#1E2125</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#1E2125</Color>
  <Color x:Key="ThemePaletteBaseHigh">#ECEFF2</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
</ResourceDictionary>
