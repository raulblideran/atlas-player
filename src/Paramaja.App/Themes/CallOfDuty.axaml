<!--
  The "Call of Duty" theme. Military olive and HUD yellow, square edges and stencil type.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#0A0B08" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#11130E" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#191C14" />
  <SolidColorBrush x:Key="ThemeHover" Color="#24281D" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#3A3F2C" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#2A2E1E" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F211130E" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#E6E8DC" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#A6AB93" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#E8B923" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#F5C93A" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#0A0B08" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#FF8A1F" />
  <SolidColorBrush x:Key="ThemePositive" Color="#9BD14B" />
  <!-- The bars over the video: a light fade into the picture (75% at the edge), no line -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#EEF0E6" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#BF070805" />
    <GradientStop Offset="0.5" Color="#66070805" />
    <GradientStop Offset="1" Color="#00070805" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#00070805" />
    <GradientStop Offset="0.4" Color="#66070805" />
    <GradientStop Offset="1" Color="#BF070805" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarEdge" Color="#00000000" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#55E8B923" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#E8B923" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#F5C93A" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#0A0B08" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#26E6E8DC" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#80E8B923" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#EEF0E6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40E6E8DC" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70E6E8DC" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#E8B923" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#E8B923" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F211130E" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#EEF0E6" />
  <!-- The welcome screen and titles -->
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#1A1E12" />
    <GradientStop Offset="0.6" Color="#0E100A" />
    <GradientStop Offset="1" Color="#070805" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#E8B923" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">0</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">0</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">0</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">0</CornerRadius>
  <!-- Titles' type (body text is Inter in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">avares://Paramaja/Assets/Fonts#Black Ops One</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">38</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#E8B923</Color>
  <Color x:Key="ThemePaletteRegionColor">#11130E</Color>
  <Color x:Key="ThemePaletteAltHigh">#0A0B08</Color>
  <Color x:Key="ThemePaletteChromeLow">#11130E</Color>
  <Color x:Key="ThemePaletteChromeMedium">#191C14</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#191C14</Color>
  <Color x:Key="ThemePaletteBaseHigh">#E6E8DC</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0A0B08" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0A0B08" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0A0B08" />
</ResourceDictionary>
