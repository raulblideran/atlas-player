<!--
  The "Windows Media Player" theme. Glossy black and glowing blue, a round play button.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#05080D" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#0B1220" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#13203A" />
  <SolidColorBrush x:Key="ThemeHover" Color="#1B2E52" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#2A4170" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#1A3260" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F20B1220" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#EAF2FF" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#9FB3D1" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#1A72CF" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#2E8BEF" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#7FD0FF" />
  <SolidColorBrush x:Key="ThemePositive" Color="#6BD66B" />
  <!-- The bars over the video -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F2F4F6" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#F203060C" />
    <GradientStop Offset="0.6" Color="#B303060C" />
    <GradientStop Offset="1" Color="#0003060C" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#0003060C" />
    <GradientStop Offset="0.35" Color="#B303060C" />
    <GradientStop Offset="1" Color="#F203060C" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#551A72CF" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#661A72CF" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F2F4F6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeSeekProgress">
    <GradientStop Offset="0" Color="#1E6FD9" />
    <GradientStop Offset="1" Color="#7FD0FF" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F20B1220" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F2F4F6" />
  <!-- The welcome screen and titles -->
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#0B1A33" />
    <GradientStop Offset="0.6" Color="#06101F" />
    <GradientStop Offset="1" Color="#000000" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeTitle">
    <GradientStop Offset="0" Color="#CFE8FF" />
    <GradientStop Offset="1" Color="#7FB8FF" />
  </LinearGradientBrush>
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">3</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">6</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">8</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">16</CornerRadius>
  <!-- Titles' type (body text is the interface font in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">fonts:Inter#Inter</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">SemiBold</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">34</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#1A72CF</Color>
  <Color x:Key="ThemePaletteRegionColor">#0B1220</Color>
  <Color x:Key="ThemePaletteAltHigh">#05080D</Color>
  <Color x:Key="ThemePaletteChromeLow">#0B1220</Color>
  <Color x:Key="ThemePaletteChromeMedium">#13203A</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#13203A</Color>
  <Color x:Key="ThemePaletteBaseHigh">#EAF2FF</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
</ResourceDictionary>
