<!--
  The "Miami Marina" theme. Sunlit sand, sky blue and marina teal, ocean-blue type.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#F8E8D6" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#FBF2E7" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHover" Color="#F2DFC8" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#E2CDB4" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#DCEBF5" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#FAFBF2E7" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#0E3E5A" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#435E70" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#0E5E8A" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#11709F" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#11706B" />
  <SolidColorBrush x:Key="ThemePositive" Color="#466F2B" />
  <!-- The bars over the video: solid grounds, a line in ThemeBarEdge parting them from the picture -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#0E3E5A" />
  <SolidColorBrush x:Key="ThemeBarScrimTop" Color="#F8E8D6" />
  <SolidColorBrush x:Key="ThemeBarScrimBottom" Color="#F8E8D6" />
  <SolidColorBrush x:Key="ThemeBarEdge" Color="#E2CDB4" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#1F0E3E5A" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#550E5E8A" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#0E5E8A" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#11709F" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#1F0E3E5A" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#400E5E8A" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#0E3E5A" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#330E3E5A" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#590E3E5A" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeSeekProgress">
    <GradientStop Offset="0" Color="#0E5E8A" />
    <GradientStop Offset="1" Color="#2CB7B0" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#0E5E8A" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#FAFFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#0E3E5A" />
  <!-- The welcome screen and titles -->
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#A7D3F5" />
    <GradientStop Offset="0.45" Color="#D4E6EE" />
    <GradientStop Offset="1" Color="#F8E8D6" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeTitle">
    <GradientStop Offset="0" Color="#0E5E8A" />
    <GradientStop Offset="0.5" Color="#2CB7B0" />
    <GradientStop Offset="1" Color="#5FA8D8" />
  </LinearGradientBrush>
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">16</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">16</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is the interface font in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">avares://AtlasPlayer/Assets/Fonts#Audiowide</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">46</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">28</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">22</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#0E5E8A</Color>
  <Color x:Key="ThemePaletteRegionColor">#FBF2E7</Color>
  <Color x:Key="ThemePaletteAltHigh">#F8E8D6</Color>
  <Color x:Key="ThemePaletteChromeLow">#FBF2E7</Color>
  <Color x:Key="ThemePaletteChromeMedium">#FFFFFF</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#FFFFFF</Color>
  <Color x:Key="ThemePaletteBaseHigh">#0E3E5A</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
</ResourceDictionary>
