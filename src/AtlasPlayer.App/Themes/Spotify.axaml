<!--
  The "Spotify" theme. Spotify's black and grey with its green, pill buttons.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#121212" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#181818" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#282828" />
  <SolidColorBrush x:Key="ThemeHover" Color="#2A2A2A" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#3E3E3E" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#1F3A28" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F2181818" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#B3B3B3" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#1DB954" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#1ED760" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#000000" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#1ED760" />
  <SolidColorBrush x:Key="ThemePositive" Color="#1DB954" />
  <!-- The bars over the video: they fade into the picture, with no line -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F2F4F6" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#F20A0A0A" />
    <GradientStop Offset="0.6" Color="#B30A0A0A" />
    <GradientStop Offset="1" Color="#000A0A0A" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#000A0A0A" />
    <GradientStop Offset="0.35" Color="#B30A0A0A" />
    <GradientStop Offset="1" Color="#F20A0A0A" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarEdge" Color="#00000000" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#551DB954" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#1DB954" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#1ED760" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#000000" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#661DB954" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F2F4F6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#1DB954" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F2181818" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F2F4F6" />
  <!-- The welcome screen and titles -->
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#1F4D2E" />
    <GradientStop Offset="0.45" Color="#16301F" />
    <GradientStop Offset="1" Color="#121212" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#FFFFFF" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">20</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">8</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is the interface font in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">fonts:Inter#Inter</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Bold</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">34</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#1DB954</Color>
  <Color x:Key="ThemePaletteRegionColor">#181818</Color>
  <Color x:Key="ThemePaletteAltHigh">#121212</Color>
  <Color x:Key="ThemePaletteChromeLow">#181818</Color>
  <Color x:Key="ThemePaletteChromeMedium">#282828</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#282828</Color>
  <Color x:Key="ThemePaletteBaseHigh">#FFFFFF</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#000000" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#000000" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#000000" />
</ResourceDictionary>
