<!--
  The "Tropical Vice" theme. Lagoon and fresh mint under mango, sunburn and peachy pink.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#0C2A2E" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#103238" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#17474E" />
  <SolidColorBrush x:Key="ThemeHover" Color="#1E5860" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#2A6D75" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#1F5C62" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#F2103238" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#FFF8F2" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#B9D6D2" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#FF786B" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#FF8E83" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#2A0B07" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#F6D36B" />
  <SolidColorBrush x:Key="ThemePositive" Color="#65C6B4" />
  <!-- The bars over the video: they fade into the picture, with no line -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#F2F4F6" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimTop">
    <GradientStop Offset="0" Color="#F2082024" />
    <GradientStop Offset="0.6" Color="#B3082024" />
    <GradientStop Offset="1" Color="#00082024" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeBarScrimBottom">
    <GradientStop Offset="0" Color="#00082024" />
    <GradientStop Offset="0.35" Color="#B3082024" />
    <GradientStop Offset="1" Color="#F2082024" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeBarEdge" Color="#00000000" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#55FF786B" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#FF786B" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#FF8E83" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#2A0B07" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#80FF786B" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#F2F4F6" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#70FFFFFF" />
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeSeekProgress">
    <GradientStop Offset="0" Color="#65C6B4" />
    <GradientStop Offset="0.333" Color="#F6D36B" />
    <GradientStop Offset="0.667" Color="#FF786B" />
    <GradientStop Offset="1" Color="#F7B7C8" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#F2103238" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#F2F4F6" />
  <!-- The welcome screen and titles -->
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#0C2A2E" />
    <GradientStop Offset="0.45" Color="#17474E" />
    <GradientStop Offset="0.8" Color="#247B83" />
    <GradientStop Offset="1" Color="#2C6F6A" />
  </LinearGradientBrush>
  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%" x:Key="ThemeTitle">
    <GradientStop Offset="0" Color="#65C6B4" />
    <GradientStop Offset="0.333" Color="#F6D36B" />
    <GradientStop Offset="0.667" Color="#FF786B" />
    <GradientStop Offset="1" Color="#F7B7C8" />
  </LinearGradientBrush>
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">10</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">18</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">18</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is the interface font in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">avares://AtlasPlayer/Assets/Fonts#Anton</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Normal</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">46</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">28</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">22</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#FF786B</Color>
  <Color x:Key="ThemePaletteRegionColor">#103238</Color>
  <Color x:Key="ThemePaletteAltHigh">#0C2A2E</Color>
  <Color x:Key="ThemePaletteChromeLow">#103238</Color>
  <Color x:Key="ThemePaletteChromeMedium">#17474E</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#17474E</Color>
  <Color x:Key="ThemePaletteBaseHigh">#FFF8F2</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#2A0B07" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#2A0B07" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#2A0B07" />
</ResourceDictionary>
