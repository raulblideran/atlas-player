<!--
  The "Atlas Light" theme: Atlas's blue and gold on light grounds, for bright rooms.

  Every theme defines the same keys (ThemeTests checks it). To add a theme: copy this file,
  change the values, and add one line to Services/ThemeRegistry.cs. Views use these keys only
  through DynamicResource, so a theme switches live.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Grounds: the player, windows, raised groups and menus, hovered rows, lines -->
  <SolidColorBrush x:Key="ThemeBg" Color="#F2F5FA" />
  <SolidColorBrush x:Key="ThemeSurface" Color="#FAFBFD" />
  <SolidColorBrush x:Key="ThemeRaised" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHover" Color="#E7EDF7" />
  <SolidColorBrush x:Key="ThemeStroke" Color="#CDD7E8" />
  <SolidColorBrush x:Key="ThemeNavSelected" Color="#DDE6F5" />
  <SolidColorBrush x:Key="ThemeFlyout" Color="#FAFFFFFF" />
  <!-- Text -->
  <SolidColorBrush x:Key="ThemeText" Color="#0E1A30" />
  <SolidColorBrush x:Key="ThemeTextMuted" Color="#4A5A75" />
  <!-- Accent (buttons, selection), its text, and the status colours -->
  <SolidColorBrush x:Key="ThemeAccent" Color="#1E4F9E" />
  <SolidColorBrush x:Key="ThemeAccentHover" Color="#2A61B8" />
  <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ThemeHighlight" Color="#8A5A06" />
  <SolidColorBrush x:Key="ThemePositive" Color="#1E6FD9" />
  <!-- The bars over the video: solid grounds, a line in ThemeBarEdge parting them from the picture -->
  <SolidColorBrush x:Key="ThemeBarText" Color="#0E1A30" />
  <SolidColorBrush x:Key="ThemeBarScrimTop" Color="#F2F5FA" />
  <SolidColorBrush x:Key="ThemeBarScrimBottom" Color="#F2F5FA" />
  <SolidColorBrush x:Key="ThemeBarEdge" Color="#CDD7E8" />
  <SolidColorBrush x:Key="ThemeBarButtonHover" Color="#1F0E1A30" />
  <SolidColorBrush x:Key="ThemeBarButtonPressed" Color="#551E4F9E" />
  <!-- Play, the bar's main button: its ground, hovered, and its glyph -->
  <SolidColorBrush x:Key="ThemePlay" Color="#D9A22E" />
  <SolidColorBrush x:Key="ThemePlayHover" Color="#E8B33C" />
  <SolidColorBrush x:Key="ThemeOnPlay" Color="#0A1730" />
  <SolidColorBrush x:Key="ThemeBadge" Color="#1F0E1A30" />
  <SolidColorBrush x:Key="ThemeBadgeHdr" Color="#40D4A23A" />
  <SolidColorBrush x:Key="ThemeBadgeText" Color="#0E1A30" />
  <!-- The seek bar -->
  <SolidColorBrush x:Key="ThemeSeekTrack" Color="#330E1A30" />
  <SolidColorBrush x:Key="ThemeSeekBuffered" Color="#590E1A30" />
  <SolidColorBrush x:Key="ThemeSeekProgress" Color="#1E4F9E" />
  <SolidColorBrush x:Key="ThemeSeekThumb" Color="#1E4F9E" />
  <SolidColorBrush x:Key="ThemeSeekLabel" Color="#FAFFFFFF" />
  <SolidColorBrush x:Key="ThemeSeekLabelText" Color="#0E1A30" />
  <!-- The welcome screen and titles -->
  <RadialGradientBrush Center="50%,38%" GradientOrigin="50%,38%" RadiusX="75%" RadiusY="75%" x:Key="ThemeWelcome">
    <GradientStop Offset="0" Color="#E3ECF9" />
    <GradientStop Offset="1" Color="#F2F5FA" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="ThemeTitle" Color="#0E1A30" />
  <!-- Shape: small (badges, swatches), controls (buttons, fields), large (groups, menus), bar buttons -->
  <CornerRadius x:Key="ThemeRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusControl">8</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusLarge">12</CornerRadius>
  <CornerRadius x:Key="ThemeRadiusIconButton">20</CornerRadius>
  <!-- Titles' type (body text is Inter in every theme) -->
  <FontFamily x:Key="ThemeHeadingFont">fonts:Inter#Inter</FontFamily>
  <FontWeight x:Key="ThemeHeadingWeight">Bold</FontWeight>
  <x:Double x:Key="ThemeHeadingSizeHero">34</x:Double>
  <x:Double x:Key="ThemeHeadingSizePage">24</x:Double>
  <x:Double x:Key="ThemeHeadingSizeDialog">20</x:Double>
  <!-- Fluent's own controls (switches, sliders, drop-downs) follow these -->
  <Color x:Key="ThemePaletteAccent">#1E4F9E</Color>
  <Color x:Key="ThemePaletteRegionColor">#FAFBFD</Color>
  <Color x:Key="ThemePaletteAltHigh">#F2F5FA</Color>
  <Color x:Key="ThemePaletteChromeLow">#FAFBFD</Color>
  <Color x:Key="ThemePaletteChromeMedium">#FFFFFF</Color>
  <Color x:Key="ThemePaletteChromeMediumLow">#FFFFFF</Color>
  <Color x:Key="ThemePaletteBaseHigh">#0E1A30</Color>
  <!-- Fluent's switch knob, on the accent: the accent's own text colour -->
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
</ResourceDictionary>
