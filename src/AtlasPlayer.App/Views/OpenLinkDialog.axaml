<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AtlasPlayer.App.ViewModels"
        x:Class="AtlasPlayer.App.Views.OpenLinkDialog"
        x:DataType="vm:OpenLinkDialogViewModel"
        Title="Open Link" Icon="/Assets/atlas-player.ico"
        Width="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ThemeSurface}">
  <DockPanel>
    <Border Classes="footer" DockPanel.Dock="Bottom">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="ghost" Content="Cancel" Click="OnCancel" IsCancel="True" />
        <Button Classes="accent" Content="Play" Click="OnPlay" IsDefault="True" IsEnabled="{Binding IsValid}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="24,22,24,20" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <PathIcon Classes="title" Data="{StaticResource IconLink}" />
        <TextBlock Classes="dialog" Text="Open Link" />
      </StackPanel>
      <TextBlock Classes="note" FontSize="13.5"
                 Text="Paste a magnet link, a MEGA file link, a YouTube (or other video site) link or a direct link to a video. Playback starts once the first few seconds have loaded." />
      <TextBox x:Name="Input" Text="{Binding Text}" Watermark="magnet:?…   https://mega.nz/file/…   https://youtube.com/watch?v=…" AcceptsReturn="False"
               TextWrapping="Wrap" MaxHeight="120" />
      <TextBlock Text="{Binding Hint}" Classes="status" />
    </StackPanel>
  </DockPanel>
</Window>
