<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AtlasPlayer.App.ViewModels"
        xmlns:c="using:AtlasPlayer.App.Controls"
        x:Class="AtlasPlayer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}" Icon="/Assets/atlas-player.ico"
        Width="1280" Height="760" MinWidth="720" MinHeight="420"
        Background="{DynamicResource ThemeBg}" DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">
  <Panel>
    <!-- mpv renders into this native surface -->
    <c:VideoHost x:Name="Video" />
    <!-- libVLC renders discs (with their menus) into this one; only one surface is shown at a time -->
    <c:VideoHost x:Name="DiscVideo" />

    <!-- Welcome / idle screen (the video surface is collapsed while idle): every way in, named. -->
    <Grid x:Name="Welcome" IsVisible="{Binding IsIdle}" Background="{DynamicResource ThemeWelcome}" RowDefinitions="*,Auto">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Margin="24,32" Spacing="22">
          <StackPanel Orientation="Horizontal" Spacing="18">
            <Image Source="/Assets/atlas-player-256.png" Width="84" Height="84" />
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Classes="hero" Text="Atlas Player" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Width="340"
                         Text="Drop a video, a folder or a disc image here, or paste a link with Ctrl+V." />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="2">
            <Button x:Name="OpenFileAction" Classes="action primary" Command="{Binding OpenFileCommand}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <PathIcon Data="{StaticResource IconFile}" />
                <TextBlock Grid.Column="1" Text="Open file…" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="shortcut" Text="Ctrl+O" />
              </Grid>
            </Button>
            <Button x:Name="OpenFolderAction" Classes="action" Command="{Binding OpenFolderCommand}"
                    ToolTip.Tip="Plays every video in it, one after another">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <PathIcon Data="{StaticResource IconFolder}" />
                <TextBlock Grid.Column="1" Text="Open folder…" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="shortcut" Text="Ctrl+Shift+O" />
              </Grid>
            </Button>
            <Button x:Name="OpenDiscAction" Classes="action" Command="{Binding OpenDiscCommand}"
                    ToolTip.Tip="A DVD, Blu-ray or Audio CD, from a drive, a folder or a disc image">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <PathIcon Data="{StaticResource IconDisc}" />
                <TextBlock Grid.Column="1" Text="Open disc…" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="shortcut" Text="CD, DVD, BluRay" />
              </Grid>
            </Button>
            <Button x:Name="OpenLinkButton" Classes="action" Command="{Binding OpenLinkCommand}"
                    ToolTip.Tip="A magnet, YouTube, MEGA or any video address">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <PathIcon Data="{StaticResource IconLink}" />
                <TextBlock Grid.Column="1" Text="Open link…" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="shortcut" Text="Ctrl+U" />
              </Grid>
            </Button>
            <Border Height="1" Background="{DynamicResource ThemeStroke}" Margin="14,8" />
            <Button x:Name="DownloaderButton" Classes="action" Command="{Binding OpenDownloaderCommand}"
                    ToolTip.Tip="Save a YouTube (or other site) video in the quality you choose, or just its audio">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <PathIcon Data="{StaticResource IconDownload}" />
                <TextBlock Grid.Column="1" Text="Download video…" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="shortcut" Text="YouTube and more" />
              </Grid>
            </Button>
            <Button x:Name="RipDiscAction" Classes="action" Command="{Binding OpenRipperCommand}"
                    ToolTip.Tip="Copy an Audio CD to FLAC or WAV, or a DVD to MKV or its VIDEO_TS folder">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <PathIcon Data="{StaticResource IconRip}" />
                <TextBlock Grid.Column="1" Text="Rip disc…" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="shortcut" Text="CD, DVD, Audio from DVD" />
              </Grid>
            </Button>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsResolving}" Spacing="6">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Text="{Binding BufferingText}" HorizontalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeHighlight}" />
          </StackPanel>
          <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{DynamicResource ThemeHighlight}"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="18,0,14,12">
        <TextBlock Text="{Binding AppVersionLine}" Classes="muted" FontSize="11" VerticalAlignment="Bottom" />
        <Button x:Name="SettingsAction" Grid.Column="1" Classes="action" Command="{Binding OpenSettingsCommand}"
                HorizontalAlignment="Right" Padding="10,7">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" />
            <TextBlock Text="Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Panel>
</Window>
